PORT=5000
MONGODB_URI=your_mongodb_connection_string
# Optional - defaults to "ideavault"
MONGODB_DB=ideavault

# URL of the Next.js client. The server fetches its public signing keys from
#   <CLIENT_URL>/api/auth/jwks   to verify logins. REQUIRED for any write.
CLIENT_URL=http://localhost:3000
# Optional: override the full JWKS URL
# AUTH_JWKS_URL=https://your-client.vercel.app/api/auth/jwks